<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spring Boot 4.1.x: sube al ultimo parche de la 4.1 cuando empieces (start.spring.io). -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.shopflow</groupId>
  <artifactId>shopflow-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>shopflow-parent</name>
  <description>Plataforma de pedidos y pagos orientada a eventos (Kafka y Docker)</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!--
    Modulos: se van anadiendo hito a hito.
      hito 1  -> order-service
      hito 2  -> notification-service
      hito 3  -> common-events
      hito 4  -> inventory-service
      hito 5  -> payment-service, fraud-service
      hito 7  -> api-gateway, auth-service, config-server

    Cuando crees el primero, descomenta este bloque y anade cada modulo:

    <modules>
      <module>order-service</module>
    </modules>
  -->
</project>
